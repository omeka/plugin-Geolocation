#: config_form.php:10
msgid ""
"Latitude of the map's initial center point, in degrees. Must be between -90 "
"and 90."
msgstr "Szerokość geograficzna początkowego, centralnego punktu mapy w stopniach. Musi zawierać się pomiędzy -90 i 90."

